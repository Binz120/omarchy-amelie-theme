{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/omarchy/branding/about.txt",
    "color": { "1": "cyan", "2": "yellow" },
    "padding": { "top": 2, "right": 6, "left": 2 }
  },
  "display": {
    "disableLinewrap": true
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;232;176;74mAMÉLIE\u001b[0m \u001b[38;2;158;203;166m/ CAFÉ · MÉTRO · CRÈME BRÛLÉE\u001b[0m"
    },
    "break",
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;131;157;92m┌──────────────────────Hardware──────────────────────┐"
    },
    { "type": "host", "key": " PC", "keyColor": "cyan" },
    { "type": "cpu", "key": "│ ├", "showPeCoreCount": true, "keyColor": "cyan" },
    { "type": "gpu", "key": "│ ├", "detectionMethod": "pci", "format": "{name}", "keyColor": "cyan" },
    { "type": "display", "key": "│ ├󱄄", "keyColor": "cyan" },
    { "type": "disk", "key": "│ ├󰋊", "keyColor": "cyan" },
    { "type": "memory", "key": "│ ├", "keyColor": "cyan" },
    { "type": "swap", "key": "└ └󰓡", "keyColor": "cyan" },
    {
      "type": "custom",
      "format": "\u001b[38;2;131;157;92m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;131;157;92m┌──────────────────────Software──────────────────────┐"
    },
    { "type": "command", "key": " OS", "keyColor": "yellow", "text": "version=$(omarchy-version) && echo \"Omarchy $version\"" },
    { "type": "command", "key": "│ ├󰘬", "keyColor": "yellow", "text": "omarchy-version-branch" },
    { "type": "command", "key": "│ ├󰔫", "keyColor": "yellow", "text": "channel=$(omarchy-version-channel); echo \"$channel\"" },
    { "type": "kernel", "key": "│ ├", "keyColor": "yellow" },
    { "type": "wm", "key": "│ ├", "keyColor": "yellow" },
    { "type": "de", "key": " DE", "keyColor": "yellow" },
    { "type": "terminal", "key": "│ ├", "keyColor": "yellow" },
    { "type": "packages", "key": "│ ├󰏖", "keyColor": "yellow" },
    { "type": "wmtheme", "key": "│ ├󰉼", "keyColor": "yellow" },
    {
      "type": "command",
      "key": "│ ├󰸌",
      "keyColor": "yellow",
      "text": "theme=$(omarchy-theme-current); echo -e \"$theme \\e[38m●\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●\""
    },
    { "type": "terminalfont", "key": "└ └", "keyColor": "yellow" },
    {
      "type": "custom",
      "format": "\u001b[38;2;131;157;92m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;131;157;92m┌────────────────Age / Uptime / Update───────────────┐"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "magenta",
      "text": "days=$(( ($(date +%s) - $(stat -c %W /)) / 86400 )); omarchy-i18n --count \"$days\" about.days \"$days\""
    },
    {
      "type": "command",
      "key": "󱫐 Uptime",
      "keyColor": "magenta",
      "text": "up=$(cut -d. -f1 /proc/uptime); d=$((up / 86400)); h=$((up % 86400 / 3600)); m=$((up % 3600 / 60)); if [ \"$d\" -gt 0 ]; then omarchy-i18n agents.durationDaysHours \"$d\" \"$h\"; elif [ \"$h\" -gt 0 ]; then omarchy-i18n battery.durationHoursMinutes \"$h\" \"$m\"; else omarchy-i18n battery.durationMinutes \"$m\"; fi"
    },
    {
      "type": "command",
      "key": " Update",
      "keyColor": "magenta",
      "text": "updated=$(omarchy-version-pkgs); echo \"$updated\""
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;131;157;92m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}
